{
  "name": "nemi-ai-studio",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "NEMI AI STUDIO desktop application",
  "author": "Nemee Chand Khichar",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "cd ../backend && python -m PyInstaller nemi-backend.spec --distpath dist-pyinstaller --workpath build-pyinstaller --noconfirm",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist:win": "npm run build && npm run build:backend && electron-builder --win nsis portable"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-monaco-editor-esm": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.nemi.aistudio",
    "productName": "NEMI AI STUDIO",
    "copyright": "Copyright (c) 2026 Nemee Chand Khichar",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist-pyinstaller/nemi-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
